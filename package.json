{
  "name": "os-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "host:run": "\"%LOCALAPPDATA%\\Microsoft\\dotnet\\dotnet.exe\" run --project host -- --dev http://127.0.0.1:5173",
    "host:build": "\"%LOCALAPPDATA%\\Microsoft\\dotnet\\dotnet.exe\" build host -c Release",
    "host:publish": "\"%LOCALAPPDATA%\\Microsoft\\dotnet\\dotnet.exe\" publish host -c Release -r win-x64 -o dist-host",
    "ship": "npm run build && npm run host:publish && node scripts/ship.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node -e \"import('node:child_process').then(({spawnSync})=>process.exit(spawnSync('npm',['exec','--','tauri','build',...(process.platform==='darwin'?['--bundles','app']:['--no-bundle'])],{stdio:'inherit',shell:true}).status??1))\""
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@tauri-apps/api": "^2.11.1",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "vite": "^8.2.2"
  }
}
