{
  "name": "ose",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "node dev/test-server.mjs",
    "build": "vite build --config vite.kernel.config.js",
    "build:kernel": "vite build --config vite.kernel.config.js",
    "embed:shell": "node scripts/embed-shell.mjs",
    "ship": "npm run tauri:build && node scripts/ship.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node -e \"import('node:child_process').then(({spawnSync})=>process.exit(spawnSync('npm',['exec','--','tauri','build',...(process.platform==='darwin'?['--bundles','app']:['--no-bundle'])],{stdio:'inherit',shell:true}).status??1))\""
  },
  "dependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@tauri-apps/api": "^2.11.1",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "vite": "^8.2.2"
  }
}
