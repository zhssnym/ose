{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": false,
    "paths": {
      "ose:core": [
        "./src/core/core.ts"
      ],
      "ose:ui": [
        "./src/core/ui.ts"
      ],
      "ose:editor": [
        "./src/editor/lib.ts"
      ],
      "ose:planner": [
        "./src/planner/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "shell/**/*.js"
  ]
}
