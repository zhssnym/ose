<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>os</AssemblyName>
    <RootNamespace>OsEditor</RootNamespace>
    <ApplicationIcon>os.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.1.0</Version>
    <Product>os editor</Product>
    <AssemblyTitle>os editor</AssemblyTitle>
    <Company>os</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Publish shape: one compressed self-contained exe. -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!-- Keep the package's .xml doc files out of the publish folder. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- The package references its WPF assembly unconditionally, which drags in a second
       WindowsBase and produces MSB3277. This host is WinForms only. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference->WithMetadataValue('Filename','Microsoft.Web.WebView2.Wpf'))" />
    </ItemGroup>
  </Target>

  <!--
    The Vite build output. It may not exist yet; when it does not, only the built-in
    placeholder page is embedded and https://app.os/ shows "UI not built".
    LogicalName keeps the OS directory separator; EmbeddedUi normalises it to '/'.
  -->
  <PropertyGroup>
    <UiDist Condition="'$(UiDist)' == ''">$(MSBuildProjectDirectory)\..\dist\</UiDist>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(UiDist)')">
    <_OsUiFile Include="$(UiDist)**\*" />
    <EmbeddedResource Include="@(_OsUiFile)" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="builtin\placeholder.html" LogicalName="builtin/index.html" />
    <EmbeddedResource Include="builtin\selftest.html" LogicalName="builtin/selftest.html" />
  </ItemGroup>

</Project>
